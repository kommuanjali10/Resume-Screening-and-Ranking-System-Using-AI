# Resume Screening and Ranking System Using AI - Environment Configuration Example
# Copy this file to server/.env and adjust values if necessary.

# Server Port
PORT=5000

# MongoDB Connection URI
# Option 1: Local MongoDB (Default standalone / service)
MONGODB_URI=mongodb://127.0.0.1:27017/resume_screening_db

# Option 2: MongoDB Atlas Cloud (Replace <username>, <password>, <cluster-url>)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume_screening_db?retryWrites=true&w=majority

# JWT Secret Key for Recruiter Authentication
JWT_SECRET=super_secure_resume_screening_jwt_secret_key_2026_review1

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
